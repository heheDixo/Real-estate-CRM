# ── HuggingFace ────────────────────────────────────────────────
HF_TOKEN=hf_your_token_here

# ── Apollo ─────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_key_here

# ── NewsAPI (free tier — 100 req/day) ──────────────────────────
NEWSAPI_KEY=your_newsapi_key_here

# ── Hunter.io (free tier — 25 verifies/month) ──────────────────
HUNTER_API_KEY=your_hunter_key_here

# ── Firecrawl (free tier — clean website scraping) ─────────────
FIRECRAWL_API_KEY=your_firecrawl_key_here

# ── Agent identity (shown in emails and UI) ────────────────────
AGENT_NAME=Michael Hartley
AGENT_TITLE=Senior Director, Tenant Representation
FIRM_NAME=Hartley CRE Partners
AGENT_PHONE=+1 (212) 555-0147
AGENT_EMAIL=michael@hartleycre.com

# ── Gmail SMTP sending ─────────────────────────────────────────
# To enable the "Send via Gmail" button on the Draft review page:
#   1. Enable 2-Step Verification on your Google account
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters (no spaces) into GMAIL_APP_PASSWORD below
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_SENDER=michael@hartleycre.com
DEMO_RECIPIENT=

# ── Google OAuth (Gmail drafts, Sheets, Calendar share one creds file) ─
# Download from https://console.cloud.google.com → APIs & Services → Credentials
# Save the OAuth client JSON as ./credentials.json
GOOGLE_CREDENTIALS_PATH=credentials.json
SHEETS_SPREADSHEET_ID=
CALENDAR_ID=primary

# ── Morning research schedule ──────────────────────────────────
RESEARCH_CRON_HOUR=5
RESEARCH_CRON_MINUTE=0
DIGEST_SEND_HOUR=7
BROKER_EMAIL=michael@hartleycre.com
TIMEZONE=America/New_York

# When true, app.py spawns the APScheduler thread on startup.
# Keep false during Streamlit dev — run "python scheduler.py" separately.
START_SCHEDULER=false

# ── Demo control ───────────────────────────────────────────────
# Set to true to use mock data regardless of API key availability
FORCE_MOCK_MODE=

# ── Supabase ───────────────────────────────────────────────────
# Get these from: Supabase dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Google OAuth — Web app credentials (Phase 2) ───────────────
# Create at: Google Cloud Console → Credentials → OAuth client ID (Web app)
# Redirect URI must match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# URLs — update both after a hosted deploy
FASTAPI_URL=http://localhost:8000
STREAMLIT_URL=http://localhost:8501

# Email whitelist — only these emails can complete Google sign-in.
# Comma-separated; leave blank to allow any Google account (NOT for production).
ALLOWED_EMAILS=

# ── Telegram bot (Phase 4) ─────────────────────────────────────
# Create the bot via @BotFather on Telegram, /newbot, copy the token.
# Username is everything before "bot" in the t.me URL (no @ prefix).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CREOutreachBot
